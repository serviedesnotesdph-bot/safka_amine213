SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=sqlite:///safqa.db
ADMIN_EMAIL=admin@safqa.dz
ADMIN_PASSWORD=admin123456
# Email SMTP (laisser vide = mode démo dans la console)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=noreply@safqa-belabbes.dz

# SMS (laisser vide = mode démo dans la console)
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# URL publique (pour les liens dans les emails)
PUBLIC_BASE_URL=http://localhost:5000
# Chargily Pay (paiement en ligne CIB/Edahabia)
# Laisser CHARGILY_SECRET_KEY vide pour désactiver le paiement en ligne
# Mode : "test" (sandbox) ou "live" (production)
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=
CHARGILY_PUBLIC_KEY=

# URL publique (pour les redirections de paiement)
PUBLIC_BASE_URL=http://localhost:5000
